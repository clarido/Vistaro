{
  "meta": {
    "title": "Follow camera",
    "slug": "showcase-follow",
    "app": "Clarido",
    "locale": "en",
    "cursor": "mac",
    "tailMs": 2600,
    "motion": {
      "cursor": "natural"
    }
  },
  "steps": [
    {
      "id": "intro",
      "time": "0s",
      "action": "fadeIn",
      "target": "body",
      "guide": false
    },
    {
      "id": "follow",
      "time": "0.8s",
      "action": "camera",
      "target": "#item-1",
      "scale": 1.3,
      "follow": true,
      "duration": 1.4,
      "title": "Turn the follow camera on"
    },
    {
      "id": "pick",
      "time": "3.4s",
      "action": "click",
      "target": "#item-3",
      "title": "It pans while the cursor travels"
    },
    {
      "id": "ask",
      "time": "5.6s",
      "action": "type",
      "target": "#ask-input",
      "value": "What is due this week?",
      "title": "Across the page"
    },
    {
      "id": "new",
      "time": "9.4s",
      "action": "click",
      "target": "#chip-2",
      "title": "One camera step, every interaction"
    },
    {
      "id": "pull-back",
      "time": "11.4s",
      "action": "camera",
      "scale": 1,
      "duration": 1.4,
      "title": "Pull back",
      "subtitle": "The next camera step ends the follow."
    }
  ]
}
