{
  "meta": {
    "kind": "reel",
    "title": "Write the timeline, get the demos",
    "slug": "demoforge-reel",
    "app": "Demoforge",
    "locale": "en",
    "cursor": "none",
    "tailMs": 600,
    "reel": {
      "loop": true,
      "autoplay": "message",
      "poster": "5.1s"
    }
  },
  "steps": [
    {
      "id": "ask",
      "time": "0s",
      "action": "animate",
      "target": "#ask",
      "from": { "opacity": 0, "y": -10 },
      "to": { "opacity": 1, "y": 0 },
      "duration": 0.45,
      "ease": "easeOutCubic"
    },
    {
      "id": "win",
      "time": "0.55s",
      "action": "animate",
      "target": "#app",
      "from": { "opacity": 0, "y": 14 },
      "to": { "opacity": 1, "y": 0 },
      "duration": 0.5,
      "ease": "easeOutCubic"
    },
    {
      "id": "lines",
      "time": "0.9s",
      "action": "animate",
      "target": ".eline",
      "all": true,
      "count": 15,
      "stagger": 0.04,
      "from": { "opacity": 0, "x": -10 },
      "to": { "opacity": 1, "x": 0 },
      "duration": 0.35,
      "ease": "easeOutCubic"
    },
    {
      "id": "cmd1",
      "time": "1.8s",
      "action": "animate",
      "target": "#cmd1",
      "from": { "opacity": 0, "x": -8 },
      "to": { "opacity": 1, "x": 0 },
      "duration": 0.35,
      "ease": "easeOutCubic"
    },
    {
      "id": "ok1",
      "time": "2.25s",
      "action": "animate",
      "target": "#ok1",
      "from": { "opacity": 0, "y": 6 },
      "to": { "opacity": 1, "y": 0 },
      "duration": 0.35,
      "ease": "easeOutCubic"
    },
    {
      "id": "cmd2",
      "time": "2.85s",
      "action": "animate",
      "target": "#cmd2",
      "from": { "opacity": 0, "x": -8 },
      "to": { "opacity": 1, "x": 0 },
      "duration": 0.35,
      "ease": "easeOutCubic"
    },
    {
      "id": "wait",
      "time": "3.35s",
      "action": "animate",
      "target": ".rail-wait",
      "from": { "opacity": 1 },
      "to": { "opacity": 0 },
      "duration": 0.3,
      "ease": "easeInCubic"
    },
    {
      "id": "arts",
      "time": "3.5s",
      "action": "animate",
      "target": ".artifact",
      "all": true,
      "count": 4,
      "stagger": 0.11,
      "from": { "opacity": 0, "y": 18 },
      "to": { "opacity": 1, "y": 0 },
      "duration": 0.55,
      "ease": "easeOutBack"
    },
    {
      "id": "ci",
      "time": "4.45s",
      "action": "animate",
      "target": "#cichip",
      "from": { "opacity": 0, "scale": 0.94 },
      "to": { "opacity": 1, "scale": 1 },
      "duration": 0.45,
      "ease": "easeOutBack"
    },
    {
      "id": "fade",
      "time": "7.1s",
      "action": "animate",
      "target": "#stage",
      "from": { "opacity": 1 },
      "to": { "opacity": 0 },
      "duration": 0.5,
      "ease": "easeInCubic"
    }
  ]
}
