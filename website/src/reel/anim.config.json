{
  "meta": {
    "kind": "reel",
    "title": "Write the timeline, get the demos",
    "slug": "demoforge-reel",
    "app": "Demoforge",
    "locale": "en",
    "cursor": "none",
    "tailMs": 1000,
    "reel": {
      "loop": true,
      "autoplay": "message"
    }
  },
  "steps": [
    {
      "id": "win",
      "time": "0s",
      "action": "animate",
      "target": "#app",
      "from": { "opacity": 0, "y": 14 },
      "to": { "opacity": 1, "y": 0 },
      "duration": 0.5,
      "ease": "easeOutCubic"
    },
    {
      "id": "lines",
      "time": "0.4s",
      "action": "animate",
      "target": ".eline",
      "all": true,
      "count": 15,
      "stagger": 0.05,
      "from": { "opacity": 0, "x": -10 },
      "to": { "opacity": 1, "x": 0 },
      "duration": 0.4,
      "ease": "easeOutCubic"
    },
    {
      "id": "cmd1",
      "time": "2.2s",
      "action": "animate",
      "target": "#cmd1",
      "from": { "opacity": 0, "x": -8 },
      "to": { "opacity": 1, "x": 0 },
      "duration": 0.35,
      "ease": "easeOutCubic"
    },
    {
      "id": "ok1",
      "time": "2.8s",
      "action": "animate",
      "target": "#ok1",
      "from": { "opacity": 0, "y": 6 },
      "to": { "opacity": 1, "y": 0 },
      "duration": 0.35,
      "ease": "easeOutCubic"
    },
    {
      "id": "cmd2",
      "time": "3.7s",
      "action": "animate",
      "target": "#cmd2",
      "from": { "opacity": 0, "x": -8 },
      "to": { "opacity": 1, "x": 0 },
      "duration": 0.35,
      "ease": "easeOutCubic"
    },
    {
      "id": "arts",
      "time": "4.5s",
      "action": "animate",
      "target": ".artifact",
      "all": true,
      "count": 4,
      "stagger": 0.13,
      "from": { "opacity": 0, "y": 18 },
      "to": { "opacity": 1, "y": 0 },
      "duration": 0.55,
      "ease": "easeOutBack"
    },
    {
      "id": "ci",
      "time": "6s",
      "action": "animate",
      "target": "#cichip",
      "from": { "opacity": 0, "scale": 0.94 },
      "to": { "opacity": 1, "scale": 1 },
      "duration": 0.45,
      "ease": "easeOutBack"
    }
  ]
}
