node_modules/
.env
.DS_Store
*.log

# Output media
*.mp4
*.webm
*.gif
# A reel's poster is an `export` deliverable like the video beside it, not an authored file
*.poster.png

# Debug files
*-debug.png

# Claude Code local data
.claude/

# Generated previews. `--config` derives its own names from the timeline's stem
# (preview.<stem>.png, preview-<stem>-step-N.png), so those need covering too.
preview.png
preview.*.png
preview-*.png
preview-step-*.png
.temp-video/
.cache/
*.vtt
demo/**/guide/
# `guide --config` derives guide-<stem>/ per timeline
demo/**/guide-*/
# `npx tsx cli.ts build demo` regenerates these (a full copy of runtime.js each time)
demo/**/animated.html
demo/**/animated.*.html
# Same for reels: animated.html and the embed pages are generated by `build`, not authored
reels/**/animated.html
reels/**/embed-*.html
reels/**/embed.html
reels/**/embed.snippet.html
/reels-out/

# build-all outputs
/help-out/

# `npx tsx cli.ts tour` regenerates this whole site from tour.catalog.json (stale scenario pages included)
/tour-out/

# Playwright storage state (session cookies) — never commit
auth.json

# `npx skills add` installs here (symlinked into .claude/skills/)
.agents/
skills-lock.json
