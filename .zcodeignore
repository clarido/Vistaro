node_modules/
.env
.DS_Store
*.log

# Output media
*.mp4
*.webm
*.gif
# A reel's poster is an `export` deliverable like the video beside it, not an authored file
*.poster.png

# Debug files
*-debug.png

# Claude Code local data
.claude/

# Generated previews. `--config` derives its own names from the timeline's stem
# (preview.<stem>.png, preview-<stem>-step-N.png), so those need covering too.
preview.png
preview.*.png
preview-*.png
preview-step-*.png
# check --trace and filmstrip write beside their source with derived stems, like the previews.
trace.json
trace.*.json
*.strip.png
*.motion.json
.temp-video/
.cache/
# The impeccable skill's critique working notes (design passes), not source.
.impeccable/
*.vtt

# Generated artifacts, matched by what the tools EMIT rather than by where they emit it. These were
# once scoped to demo/ and reels/, which is exactly why they stopped working: a catalog names its own
# outputDir and its own source tree, so every directory added later (tours/, guides/, tour-clarido-out/)
# fell outside the scoped rules and appeared as untracked noise beside the source it came from.
#
# `guide/` is spelled out file by file on purpose: a bare `**/guide/` would also match this repo's own
# src/guide/, and while already-tracked files are immune to .gitignore, a NEW file added there would be
# silently ignored -- a trap that costs an afternoon.
**/guide/guide.json
**/guide/guide.md
**/guide/guide.html
**/guide/assets/
# `guide --config` derives guide-<stem>/ per timeline; nothing in src/ is named that
**/guide-*/
# `build` regenerates these (a full copy of runtime.js each time), with or without --config
**/animated.html
**/animated.*.html
# `build --embed` and `tour --embed`
**/embed-*.html
**/embed.html
**/embed.snippet.html

# Every output directory: reels-out, help-out, tour-out and any outputDir a catalog names itself
# (tour-clarido-out, tour-actifs-out). The whole site is regenerated from its catalog every run.
*-out/

# Playwright storage state (session cookies) — never commit
auth.json

# `npx skills add` installs here (symlinked into .claude/skills/)
.agents/
skills-lock.json

